# Test-user credentials for scripts/create-test-users.mjs and the
# Playwright E2E suite (e2e/global-setup.ts). Copy to .env.test and fill
# in — never commit .env.test itself.
#
# The E2E suite runs against your real, already-deployed Supabase project
# (VITE_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY from .env) and provisions
# these three accounts there automatically on every run — safe to re-run,
# and it self-heals the passwords below if anything changed them. See
# e2e/README.md for how to run it.
TEST_ADMIN_EMAIL=admin+test@example.com
TEST_ADMIN_PASSWORD=change-me-please
TEST_MENTOR_EMAIL=mentor+test@example.com
TEST_MENTOR_PASSWORD=change-me-please
TEST_STUDENT_EMAIL=student+test@example.com
TEST_STUDENT_PASSWORD=change-me-please

# Optional: point the E2E suite at a deployed URL (e.g. your Vercel
# preview/production URL) instead of a local dev server.
# PLAYWRIGHT_BASE_URL=https://your-app.vercel.app
